{
  "expo": {
    "name": "RankFlow",
    "slug": "rankflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rankflow",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "O RankFlow precisa acessar suas fotos para selecionar uma imagem de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    }
  }
}
