APP_ENV=development
# Em dispositivo físico, informe o IP/domínio acessível pelo celular.
PUBLIC_API_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://rankflow:rankflow@db:5432/rankflow
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRE_MINUTES=10080
SESSION_SECRET=replace-with-another-random-secret
CODEFORCES_CLIENT_ID=
CODEFORCES_CLIENT_SECRET=
CODEFORCES_DISCOVERY_URL=https://codeforces.com/.well-known/openid-configuration
CODEFORCES_CALLBACK_URL=http://localhost:8000/api/auth/codeforces/callback
MOBILE_REDIRECT_URI=rankflow://auth/callback
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Firebase Cloud Messaging - mantenha o JSON da conta de serviço fora do Git
FIREBASE_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-adminsdk.json
UPLOAD_DIR=/app/uploads
